# ---- Base image ----
FROM public.ecr.aws/amazonlinux/amazonlinux:2023

# Install base tools and Python 3.12 on Amazon Linux 2023
RUN dnf -y update && \
    dnf -y install git python3.12 python3.12-pip python3.12-devel gcc && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Keep python3/pip3 aligned to 3.12
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 312 && \
    ln -sf /usr/bin/pip3.12 /usr/bin/pip3

# Set working directory
WORKDIR /app

# Copy files
COPY requirements.txt .
COPY pyproject.toml .
COPY uv.lock .
COPY n2t ./n2t
COPY schemes ./schemes
COPY tests ./tests
COPY dev-config.env .
COPY uvicorn_log_config.json .
COPY gunicorn.conf.py .

# Install dependencies
RUN python3 -m pip install --no-cache-dir -r requirements.txt

EXPOSE 18880

# Create data directory for sqlite db
RUN mkdir -p /app/data

RUN python3 n2t -c dev-config.env loaddb

ENV N2T_SETTINGS=/app/dev-config.env

CMD ["gunicorn", "n2t.app:app", "-c", "gunicorn.conf.py"]