# Configuration file for local development
#
# e.g. local server:
#   n2t -c dev-config.env serve
#
N2T_HOST=localhost
N2T_PORT=8000
N2T_DB_CONNECTION_STRING="sqlite:////app/var/n2t.sqlite"
N2T_JSON_DIR="/app/schemes"
N2T_ENVIRONMENT="Nginx Docker-Dev"
N2T_SERVICE_PATTERN='(^https?://?n2t.net/)|(^https?://?arks.org/)'
